# ==============================================================================
# Variables de Entorno - Infraestructura Docker (UTN FRSF / GITDA)
# ==============================================================================

# InfluxDB 2.x
INFLUX_USER=admin
INFLUX_PASSWORD=<TU_PASSWORD_INFLUX_MIN_8_CHARS>
INFLUX_ORG=utn-frsf
INFLUX_BUCKET=tanques
INFLUX_TOKEN=<TU_TOKEN_INFLUX>
INFLUX_URL=http://localhost:8086

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<TU_PASSWORD_GRAFANA>
GRAFANA_PORT=3000

# Mosquitto MQTT Broker
MQTT_PORT=1883
MQTT_USER=tanques
MQTT_PASSWORD=<TU_CLAVE_MOSQUITTO>

# Nginx
NGINX_PORT=80
