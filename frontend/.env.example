# URL del dashboard de Grafana embebido por iframe
# - En PRODUCCIÓN: Nginx actúa como reverse proxy único en el puerto 80 sirviendo la SPA,
#   el backend (/api) y Grafana (/grafana). La URL relativa funciona directamente.
# - En DESARROLLO: El dev server de Vite (puerto 5173) proxia las peticiones de '/grafana'
#   hacia 'http://localhost' (donde escucha Nginx en infra/docker-compose).
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/tanques-monitor/kit-didactico-de-tanques-interconectados?orgId=1&refresh=5s&kiosk

# Intervalo de polling de telemetría en milisegundos
VITE_TELEMETRY_REFETCH_INTERVAL_MS=2000
