# URL del dashboard de Grafana embebido por iframe
# - En PRODUCCIÓN: Nginx actúa como reverse proxy único en el puerto 80 sirviendo la SPA,
#   el backend (/api) y Grafana (/grafana). La URL relativa funciona directamente.
# - En DESARROLLO: El dev server de Vite (puerto 5173) proxia las peticiones de '/grafana'
#   hacia 'http://localhost' (donde escucha Nginx en infra/docker-compose).
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/tanques-monitor/kit-didactico-de-tanques-interconectados?orgId=1&refresh=5s&kiosk

# Intervalo de polling de telemetría en milisegundos
VITE_TELEMETRY_REFETCH_INTERVAL_MS=2000

# Umbral de corte por sobrellenado (%) que la SPA dibuja en el esquema de tanques (default 85).
# Es solo visual: el corte real lo deciden el firmware y las alarmas overflow_a/overflow_b.
# Debe coincidir con OVERFLOW_THRESHOLD_PCT (firmware/tanques/config.h), overflow_threshold_pct
# (edge/config.yaml) y overflow-threshold-pct (backend application.yml). Ver checklist en AGENTS.md.
VITE_OVERFLOW_THRESHOLD_PCT=85

# Cartel opcional debajo de la barra superior (p. ej. para avisar en una demo qué es real y qué
# es simulado). Si no está definida, no se muestra ningún cartel.
# VITE_DEMO_BANNER=Demostración: nivel, temperatura y bomba simulados; caudal real.
