# ==============================================================================
# Variables de Entorno de Ejemplo - Kit Didáctico de Tanques (UTN FRSF / GITDA)
# ==============================================================================
# Copie este archivo a .env o use los archivos .env específicos de cada módulo:
# - infra/.env
# - frontend/.env (o .env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Infraestructura Docker (infra/)
# ------------------------------------------------------------------------------
# InfluxDB 2.x
INFLUX_USER=admin
INFLUX_PASSWORD=admin123456
INFLUX_ORG=utn-frsf
INFLUX_BUCKET=tanques
INFLUX_TOKEN=tanques-super-secret-token-2025
INFLUX_URL=http://localhost:8086

# Grafana OSS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# Mosquitto MQTT Broker
MQTT_PORT=1883
MQTT_USER=tanques
MQTT_PASSWORD=tanques123

# Nginx Reverse Proxy
NGINX_PORT=80

# ------------------------------------------------------------------------------
# 2. Backend Spring Boot (backend/)
# ------------------------------------------------------------------------------
# En perfil prod, estas variables son estrictamente obligatorias (sin fallback por defecto)
JWT_SECRET=tu-clave-secreta-jwt-de-al-menos-32-caracteres-segura
DOCENTE_PASSWORD=docente_password_segura
ALUMNO_PASSWORD=alumno_password_segura
MQTT_HOST=localhost

# ------------------------------------------------------------------------------
# 3. Edge Bridge (edge/)
# ------------------------------------------------------------------------------
SERIAL_PORT=COM5
# En Linux: SERIAL_PORT=/dev/serial/by-id/usb-Arduino_... o /dev/ttyUSB0

# ------------------------------------------------------------------------------
# 4. Frontend Web (frontend/)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_GRAFANA_DASHBOARD_URL=/grafana/d/tanques-monitor/kit-didactico-de-tanques-interconectados?orgId=1&refresh=5s&kiosk
